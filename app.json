{
  "expo": {
    "name": "StudyFirst",
    "slug": "StudyFirst",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/appBOt.png",
    "scheme": "studybuddy",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.ryverrr.studybuddy"
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "imageWidth": 76
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a7d82925-de41-4d5a-9b94-5acfb21ff4db"
      }
    }
  }
}
